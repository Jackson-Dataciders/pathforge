    {
      "name": "graph-viz",
      "category": "visualization",
      "description": "A themed graph or tree with optional step-by-step highlighting.",
      "interactive": true,
      "jsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "directed": {
            "default": true,
            "type": "boolean"
          },
          "layout": {
            "default": "layered",
            "type": "string",
            "enum": [
              "tree",
              "layered"
            ]
          },
          "nodes": {
            "minItems": 1,
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "steps": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "caption": {
                  "type": "string"
                },
                "highlight_nodes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "highlight_edges": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              },
              "required": [
                "caption"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "directed",
          "layout",
          "nodes",
          "edges",
          "steps"
        ],
        "additionalProperties": false
      },
      "example": {
        "id": "breadth-first-search",
        "title": "Breadth-first search",
        "directed": true,
        "layout": "layered",
        "nodes": [
          {
            "id": "start",
            "label": "Start"
          },
          {
            "id": "left",
            "label": "Left branch"
          },
          {
            "id": "right",
            "label": "Right branch"
          },
          {
            "id": "target",
            "label": "Target"
          }
        ],
        "edges": [
          {
            "from": "start",
            "to": "left"
          },
          {
            "from": "start",
            "to": "right"
          },
          {
            "from": "left",
            "to": "target"
          },
          {
            "from": "right",
            "to": "target"
          }
        ],
        "steps": [
          {
            "caption": "Begin the search at the start node.",
            "highlight_nodes": [
              "start"
            ]
          },
          {
            "caption": "Visit the left branch before moving deeper.",
            "highlight_nodes": [
              "left"
            ],
            "highlight_edges": [
              [
                "start",
                "left"
              ]
            ]
          },
          {
            "caption": "Then visit the right branch at the same depth.",
            "highlight_nodes": [
              "right"
            ],
            "highlight_edges": [
              [
                "start",
                "right"
              ]
            ]
          },
          {
            "caption": "Continue to the target from the left branch.",
            "highlight_nodes": [
              "target"
            ],
            "highlight_edges": [
              [
                "left",
                "target"
              ]
            ]
          }
        ]
      }
    },
