{
  "components": [
    {
      "name": "array-viz",
      "category": "visualization",
      "description": "A step-by-step array, stack, or queue visualization.",
      "interactive": true,
      "jsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "array",
              "stack",
              "queue"
            ]
          },
          "initial": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "steps": {
            "minItems": 1,
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "caption": {
                  "type": "string"
                },
                "op": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "set"
                        },
                        "index": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "value": {
                          "type": [
                            "string",
                            "number"
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "index",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "swap"
                        },
                        "i": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "j": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "type",
                        "i",
                        "j"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "push"
                        },
                        "value": {
                          "type": [
                            "string",
                            "number"
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "pop"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "enqueue"
                        },
                        "value": {
                          "type": [
                            "string",
                            "number"
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "dequeue"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "highlight"
                        },
                        "indices": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        }
                      },
                      "required": [
                        "type",
                        "indices"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "pointer"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "index": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "name",
                        "index"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "none"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "caption",
                "op"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "initial",
          "steps"
        ],
        "additionalProperties": false
      },
      "example": {
        "id": "bubble-sort-pass",
        "title": "One bubble-sort pass",
        "kind": "array",
        "initial": [
          5,
          1,
          4,
          2
        ],
        "steps": [
          {
            "caption": "Compare 5 and 1; the larger value moves right.",
            "op": {
              "type": "swap",
              "i": 0,
              "j": 1
            }
          },
          {
            "caption": "Compare 5 and 4; swap them to continue the pass.",
            "op": {
              "type": "swap",
              "i": 1,
              "j": 2
            }
          },
          {
            "caption": "Compare 5 and 2; the largest value reaches the end.",
            "op": {
              "type": "swap",
              "i": 2,
              "j": 3
            }
          }
        ]
      }
    },
    {
      "name": "callout",
      "category": "content",
      "description": "A themed note for important supporting information.",
