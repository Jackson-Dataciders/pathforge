{
  "components": [
    {
      "name": "callout",
      "category": "content",
      "description": "A themed note for important supporting information.",
      "interactive": false,
      "jsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "variant": {
            "type": "string",
            "enum": [
              "info",
              "tip",
              "warning",
              "danger"
            ]
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "variant",
          "body"
        ],
        "additionalProperties": false
      },
      "example": {
        "variant": "tip",
        "title": "Remember",
        "body": "Status codes are **three digits**."
      }
    },
    {
      "name": "code-challenge",
      "category": "assessment",
      "description": "An editable programming challenge checked against its tests.",
      "interactive": true,
      "jsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "enum": [
              "javascript",
              "typescript"
            ]
          },
          "starter": {
            "type": "string"
          },
          "solution": {
            "type": "string"
          },
          "tests": {
            "type": "string"
          },
          "hints": {
            "default": [],
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeout_ms": {
            "default": 5000,
            "type": "integer",
            "minimum": 1000,
            "maximum": 15000
          }
        },
        "required": [
          "id",
          "title",
          "prompt",
          "language",
          "starter",
          "solution",
          "tests",
          "hints",
          "timeout_ms"
        ],
        "additionalProperties": false
      },
      "example": {
        "id": "sum-two-numbers",
        "title": "Add two numbers",
        "prompt": "Write a function named `sum` that returns the sum of two numbers.",
        "language": "javascript",
        "starter": "function sum(a, b) {\n  return 0;\n}",
        "solution": "function sum(a, b) {\n  return a + b;\n}",
        "tests": "test('adds positive numbers', () => assert.equal(sum(2, 3), 5));\ntest('adds a negative number', () => assert.equal(sum(-2, 5), 3));\ntest('adds zero', () => assert.equal(sum(0, 0), 0));",
        "hints": [
          "Return the result of the `+` operator."
        ],
        "timeout_ms": 5000
      }
    },
    {
      "name": "code-walkthrough",
      "category": "animation",
      "description": "A code sample explained through highlighted line ranges, one step at a time.",
      "interactive": true,
      "jsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lines": {
                  "type": "string",
                  "pattern": "^[1-9]\\d*(?:-[1-9]\\d*)?$"
                },
                "caption": {
                  "type": "string"
                }
              },
              "required": [
                "lines",
                "caption"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "language",
          "code",
          "steps"
        ],
        "additionalProperties": false
      },
      "example": {
        "id": "input-validation",
        "title": "Validate a request",
        "language": "javascript",
        "code": "const input = request.body;\nif (typeof input.name !== 'string') {\n  throw new Error('Name is required');\n}\nreturn save(input.name.trim());",
        "steps": [
          {
            "lines": "1-2",
            "caption": "Read the request and verify that the name is text."
          },
          {
            "lines": "3-5",
            "caption": "Reject invalid input, then save the trimmed name."
          }
        ]
      }
    },
    {
      "name": "diagram",
      "category": "diagram",
      "description": "A Mermaid diagram themed to the active color palette.",
      "interactive": false,
      "jsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "flowchart LR\n  Draft --> Review\n  Review --> Publish",
        "caption": "A lesson moves from draft through review to publication."
      }
    },
    {
      "name": "hint",
      "category": "content",
      "description": "A collapsed disclosure for optional supporting guidance.",
      "interactive": true,
      "jsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "default": "Show hint",
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "body"
        ],
        "additionalProperties": false
      },
      "example": {
        "id": "retry-strategy",
        "body": "Retry only when the failure may be transient, and use a bounded backoff."
      }
    },
    {
      "name": "quiz",
      "category": "assessment",
      "description": "An auto-graded lesson quiz with explanations and progress reporting.",
      "interactive": true,
      "jsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "pass_threshold": {
            "default": 1,
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "questions": {
            "minItems": 1,
            "maxItems": 15,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "prompt": {
                      "type": "string"
                    },
                    "explanation": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "single"
                    },
                    "options": {
                      "minItems": 2,
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "correct": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "text",
                          "correct"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "id",
                    "prompt",
                    "explanation",
                    "type",
                    "options"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "prompt": {
                      "type": "string"
                    },
                    "explanation": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "multiple"
                    },
                    "options": {
                      "minItems": 2,
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "correct": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "text",
                          "correct"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "id",
                    "prompt",
                    "explanation",
                    "type",
                    "options"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "prompt": {
                      "type": "string"
                    },
                    "explanation": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "boolean"
                    },
                    "answer": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "prompt",
                    "explanation",
                    "type",
                    "answer"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "prompt": {
                      "type": "string"
                    },
                    "explanation": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "text"
                    },
                    "accepted": {
                      "minItems": 1,
                      "maxItems": 10,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "case_sensitive": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "prompt",
                    "explanation",
                    "type",
                    "accepted",
                    "case_sensitive"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "pass_threshold",
          "questions"
        ],
        "additionalProperties": false
      },
      "example": {
        "id": "kit-quiz",
        "title": "Knowledge check",
        "questions": [
          {
            "id": "single-choice",
            "type": "single",
            "prompt": "Which language runs in a browser without an extra runtime?",
            "explanation": "JavaScript is built into web browsers.",
            "options": [
              {
                "id": "javascript",
                "text": "JavaScript",
                "correct": true
              },
              {
                "id": "ruby",
                "text": "Ruby",
                "correct": false
              }
            ]
          },
          {
            "id": "multiple-choice",
            "type": "multiple",
            "prompt": "Which are web standards?",
            "explanation": "HTML and CSS are web standards; Markdown is not.",
            "options": [
              {
                "id": "html",
                "text": "HTML",
                "correct": true
              },
              {
                "id": "css",
                "text": "CSS",
                "correct": true
              },
              {
                "id": "markdown",
                "text": "Markdown",
                "correct": false
              }
            ]
          },
          {
            "id": "boolean",
            "type": "boolean",
            "prompt": "Can CSS style an HTML document?",
            "explanation": "CSS describes how HTML content is presented.",
            "answer": true
          },
          {
            "id": "short-text",
            "type": "text",
            "prompt": "Which markup language structures a web page?",
            "explanation": "HTML provides structure for web pages.",
            "accepted": [
              "HTML",
              "HyperText Markup Language"
            ]
          }
        ]
      }
    },
    {
      "name": "stepper",
      "category": "animation",
      "description": "A sequence of diagram or text frames with playback and step controls.",
      "interactive": true,
      "jsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "autoplay": {
            "default": false,
            "type": "boolean"
          },
          "interval_ms": {
            "default": 2500,
            "type": "integer",
            "minimum": 1000,
            "maximum": 10000
          },
          "steps": {
            "minItems": 2,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "caption": {
                  "type": "string"
                },
                "diagram": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "caption"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "autoplay",
          "interval_ms",
          "steps"
        ],
        "additionalProperties": false
      },
      "example": {
        "id": "publish-flow",
        "title": "From draft to publication",
        "autoplay": false,
        "interval_ms": 2500,
        "steps": [
          {
            "caption": "Start with a draft.",
            "diagram": "flowchart LR\n  Draft --> Review",
            "body": "The author submits the lesson for review."
          },
          {
            "caption": "Review the lesson.",
            "diagram": "flowchart LR\n  Draft --> Review\n  Review --> Publish",
            "body": "Resolve feedback before publishing."
          },
          {
            "caption": "Publish the approved lesson.",
            "body": "The lesson is now available to learners."
          }
        ]
      }
    },
    {
      "name": "tabs",
      "category": "content",
      "description": "A keyboard-accessible set of two to six content panels.",
      "interactive": true,
      "jsonSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "tabs": {
            "minItems": 2,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "body"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "tabs"
        ],
        "additionalProperties": false
      },
      "example": {
        "id": "response-formats",
        "tabs": [
          {
            "label": "JSON",
            "body": "Use JSON for structured data exchanged between services."
          },
          {
            "label": "XML",
            "body": "XML remains common in document-oriented integrations."
          }
        ]
      }
    }
  ]
}
